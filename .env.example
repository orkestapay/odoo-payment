# Copy to `.env` (git-ignored) and adjust. Never commit real values.

# Docker Compose project name: prefixes the containers and volumes. Defaults to the
# folder name; set it to keep using volumes created from another folder.
# COMPOSE_PROJECT_NAME=

# Local database (Docker only).
POSTGRES_USER=odoo
POSTGRES_PASSWORD=
ODOO_PORT=8069
# Database served by the web UI (the database manager is disabled).
ODOO_DB=odoo_poc

# OrkestaPay sandbox credentials, for your own reference while you type them in
# Odoo (Invoicing/Website > Configuration > Payment Providers > OrkestaPay).
# The module does NOT read these variables; credentials live in the provider record.
ORKESTAPAY_CLIENT_ID=
ORKESTAPAY_CLIENT_SECRET=
ORKESTAPAY_WEBHOOK_SIGNING_SECRET=

# Public URL created by `ngrok http 8069` (used for web.base.url).
NGROK_PUBLIC_URL=
