<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">OrkestaPay Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'orkestapay'" name="orkestapay_credentials">
                    <field
                        name="orkestapay_client_id"
                        required="code == 'orkestapay' and state != 'disabled'"
                    />
                    <field
                        name="orkestapay_client_secret"
                        required="code == 'orkestapay' and state != 'disabled'"
                        password="True"
                    />
                    <field
                        name="orkestapay_webhook_secret"
                        required="code == 'orkestapay' and state != 'disabled'"
                        password="True"
                        placeholder="whsec_..."
                    />
                    <field name="orkestapay_webhook_url" widget="CopyClipboardChar"/>
                    <div colspan="2" class="text-muted" name="orkestapay_webhook_instructions">
                        In the OrkestaPay portal, go to Developers → Webhooks → Add Endpoint, paste
                        the webhook URL above and subscribe to the payment.* events. Then open the
                        endpoint, copy its Signing Secret (whsec_...) and paste it in the Webhook
                        Signing Secret field. The sandbox is used in Test Mode and production when
                        Enabled.
                    </div>
                    <div colspan="2">
                        <button
                            string="Test connection"
                            type="object"
                            name="action_orkestapay_test_connection"
                            class="btn-secondary"
                            icon="fa-plug"
                            groups="base.group_system"
                        />
                    </div>
                </group>
            </group>
        </field>
    </record>
</odoo>
