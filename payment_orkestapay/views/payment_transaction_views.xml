<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_transaction_form" model="ir.ui.view">
        <field name="name">OrkestaPay Transaction Form</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <field name="provider_reference" position="after">
                <field name="orkestapay_checkout_id" invisible="provider_code != 'orkestapay'"/>
                <field name="orkestapay_payment_id" invisible="provider_code != 'orkestapay'"/>
                <field
                    name="orkestapay_card_brand"
                    invisible="provider_code != 'orkestapay' or not orkestapay_card_brand"
                />
                <field
                    name="orkestapay_card_last_four"
                    invisible="provider_code != 'orkestapay' or not orkestapay_card_last_four"
                />
            </field>
        </field>
    </record>
</odoo>
