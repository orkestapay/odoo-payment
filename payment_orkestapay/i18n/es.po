#. module: payment_orkestapay
#. odoo-python
#: code:addons/payment_orkestapay/models/payment_transaction.py:0
msgid ""
"OrkestaPay did not confirm the refund %(refund)s; it was matched with the "
"OrkestaPay refund %(refund_id)s of the same amount. Check it in the "
"OrkestaPay portal."
msgstr "OrkestaPay no confirmó el reembolso %(refund)s; se asoció con el reembolso %(refund_id)s de OrkestaPay por el mismo monto. Verifíquelo en el portal de OrkestaPay."

#. module: payment_orkestapay
#. odoo-python
#: code:addons/payment_orkestapay/models/payment_transaction.py:0
msgid ""
"OrkestaPay did not confirm the refund. Check in the OrkestaPay portal "
"whether the refund was made before trying again."
msgstr "OrkestaPay no confirmó el reembolso. Antes de intentarlo de nuevo, verifique en el portal de OrkestaPay si el reembolso se realizó."

#. module: payment_orkestapay
#. odoo-python
#: code:addons/payment_orkestapay/models/payment_transaction.py:0
msgid ""
"OrkestaPay only authorized this payment instead of charging it. Review the "
"capture settings of the checkout in the OrkestaPay portal, then capture or "
"cancel the payment there."
msgstr "OrkestaPay solo autorizó este pago en lugar de cobrarlo. Revise la configuración de captura del checkout en el portal de OrkestaPay y después capture o cancele el pago ahí."

#. module: payment_orkestapay
#. odoo-python
#: code:addons/payment_orkestapay/models/payment_transaction.py:0
msgid "OrkestaPay refused the refund."
msgstr "OrkestaPay rechazó el reembolso."

#. module: payment_orkestapay
#. odoo-python
#: code:addons/payment_orkestapay/models/payment_provider.py:0
